@using DMBBootstrapBuilder
@using DMBComponentBuilder
@using DMBPageBuilder
@model DMBDocumentationViewer.DocumentationContextOptionsViewModel
@{
    Layout = "_Layout";
}

@if (Model.HasVersionNavigation)
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom">
        <div class="small text-body-secondary">
            <span class="fw-semibold text-body">Version</span>
            <span class="ms-1">@Model.PackageId</span>
        </div>
        <nav class="d-flex flex-wrap align-items-center gap-1" aria-label="Documentation versions">
            @foreach (DMBDocumentationViewer.DocumentationVersionNavigationItem item in Model.Versions)
            {
                if (item.IsCurrent)
                {
                    <span class="btn btn-sm btn-primary active" aria-current="page">@item.Version</span>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@item.Url">@item.Version</a>
                }
            }
        </nav>
    </div>
}

<div class="mb-4">
    @(Html.TitleBuilder()
        .SetTitle("Context options", TitleLevel.One)
        .SetIcon(IconStruct.Bootstrap("bi-clipboard-check"))
        .Render())

    @using (Html.PB_P().AddClass("lead text-body-secondary mb-0").Begin())
    {
        @:Copy versioned AI context rules generated from module AIContextOptions files.
    }
</div>

@if (!Model.HasOptions)
{
    @using (Html.AlertBuilder()
        .SetTitle("No contextual options")
        .SetVariant(VariantStyle.Warning)
        .SetIcon(IconStruct.Bootstrap("bi-exclamation-triangle"))
        .Begin())
    {
        <hr />
        @:No generated contextual option exists for the selected group and version.
        <br />
        @:Add JSON files under <code>AIContextOptions/{ruleName}.json</code>, then regenerate the documentation database with DMBDocumentationBuilder.
    }
}
else
{
    @foreach (DMBDocumentationViewer.DocumentationContextOption option in Model.Options
                 .OrderBy(option => option.GroupName, StringComparer.Ordinal)
                 .ThenBy(option => option.PackageId, StringComparer.Ordinal)
                 .ThenBy(option => option.Version, StringComparer.Ordinal)
                 .ThenBy(option => option.SortOrder)
                 .ThenBy(option => option.RuleName, StringComparer.Ordinal))
    {
        @using (Html.BlockBuilder().AddClass("border rounded-3 p-4 mb-4").Begin())
        {
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                <div>
                    @Html.TitleBuilder().SetTitle(option.Title, TitleLevel.Three).SetIcon(IconStruct.Bootstrap("bi-check2-square")).AddClass("mb-1").Render()

                    @if (!string.IsNullOrWhiteSpace(option.Description))
                    {
                        @using (Html.PB_P().AddClass("text-body-secondary mb-0").Begin())
                        {
                            @option.Description
                        }
                    }
                </div>

                <code>@option.RuleName</code>
            </div>

            <div class="small text-body-secondary mb-3">
                <span class="font-monospace">@option.GroupName</span>
                <span class="mx-1">/</span>
                <span class="font-monospace">@option.PackageId</span>
                <span class="mx-1">/</span>
                <span class="font-monospace">@option.Version</span>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (!string.IsNullOrWhiteSpace(option.ScenarioName))
                {
                    <span class="badge text-bg-primary">@option.ScenarioName</span>
                }

                @foreach (string style in option.ProjectStyles)
                {
                    <span class="badge text-bg-secondary">@style</span>
                }

                @foreach (string tag in option.Tags)
                {
                    <span class="badge text-bg-light border text-body">@tag</span>
                }
            </div>

            @(Html.CodeBlock(option.ContextText, CodeLanguage.PlainText)
                .SetTitle("Context text")
                .SetCopyButton())
        }
    }
}

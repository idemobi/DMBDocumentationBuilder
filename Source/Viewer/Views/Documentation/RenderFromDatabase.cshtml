@using DMBBootstrapBuilder
@using DMBPageBuilder
@model DMBDocumentationViewer.DocumentationRenderPageViewModel
@{
    Layout = "_Layout";
}

@if (Model.HasVersionNavigation)
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom">
        <div class="small text-body-secondary">
            <span class="fw-semibold text-body">Version</span>
            <span class="ms-1">@Model.PackageId</span>
        </div>
        <nav class="d-flex flex-wrap align-items-center gap-1" aria-label="Documentation versions">
            @foreach (DMBDocumentationViewer.DocumentationVersionNavigationItem item in Model.Versions)
            {
                if (item.IsCurrent)
                {
                    <span class="btn btn-sm btn-primary active" aria-current="page">@item.Version</span>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@item.Url">@item.Version</a>
                }
            }
        </nav>
    </div>
}

@Html.Raw(Model.HtmlContent)

@using (Html.RowBuilder().Begin())
{
    @foreach (var aiResult in Model.AIResults)
    {
        if (aiResult == null || !aiResult.HasContent)
        {
            continue;
        }

        using (Html.ColBuilder().SetCol(ColSize.Col12).Begin())
        {
            @Html.TitleBuilder().SetTitle("Information for AI", TitleLevel.Three).SetIcon(IconStruct.BootstrapEnum(BootStrapEnum.bi_robot)).Render()

            <div class="text-muted">
                Generated with <strong>@aiResult.Provider</strong>
                @if (!string.IsNullOrWhiteSpace(aiResult.Model))
                {
                    <span> — @aiResult.Model</span>
                }
                @if (!string.IsNullOrWhiteSpace(aiResult.AIModel))
                {
                    <span class="ms-2">(@aiResult.AIModel)</span>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(aiResult.ShortSummary))
        {
            using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
            {
                @using (Html.AlertBuilder()
                    .SetTitle("Resume for AI")
                    .SetVariant(VariantStyle.Primary)
                    .SetIcon(IconStruct.BootstrapEnum(BootStrapEnum.bi_rocket_takeoff))
                    .Begin())
                {
                    <hr />
                    <div>@aiResult.ShortSummary</div>
                }
            }
        }

        @if (!string.IsNullOrWhiteSpace(aiResult.Keywords))
        {
            using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
            {
                @using (Html.AlertBuilder()
                    .SetTitle("Keywords for AI")
                    .SetVariant(VariantStyle.Secondary)
                    .SetIcon(IconStruct.BootstrapEnum(BootStrapEnum.bi_key))
                    .Begin())
                {
                    <hr />

                    foreach (string keyword in aiResult.Keywords
                                 .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="badge rounded-pill text-bg-secondary me-1 mb-1">@keyword</span>
                    }
                }
            }
        }

        @if (!string.IsNullOrWhiteSpace(aiResult.Summary))
        {
            using (Html.ColBuilder().SetCol(ColSize.Col12).Begin())
            {
                @using (Html.AlertBuilder()
                    .SetTitle("Documentation for AI")
                    .SetVariant(VariantStyle.Info)
                    .SetIcon(IconStruct.BootstrapEnum(BootStrapEnum.bi_robot))
                    .Begin())
                {
                    <hr />
                    <div>@aiResult.Summary</div>
                }
            }
        }
    }
}

<div class="my-5 pt-3 border-top text-center text-muted small">
    Documentation generated by DMBDocumentationBuilder @Model.BuilderVersion
</div>

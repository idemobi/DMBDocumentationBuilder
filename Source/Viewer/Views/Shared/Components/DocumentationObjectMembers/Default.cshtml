@model DMBDocumentationViewer.DocumentationObjectMembersViewModel

@{
    bool showExtensionType = Model.DisplayFlags.HasFlag(DMBDocumentationViewer.DocumentationMemberDisplayFlags.ExtensionType);
    bool showObsolete = Model.DisplayFlags.HasFlag(DMBDocumentationViewer.DocumentationMemberDisplayFlags.Obsolete);
    bool showReferenceLink = Model.DisplayFlags.HasFlag(DMBDocumentationViewer.DocumentationMemberDisplayFlags.ReferenceLink);
    bool showSignature = Model.DisplayFlags.HasFlag(DMBDocumentationViewer.DocumentationMemberDisplayFlags.Signature);
    bool showSummary = Model.DisplayFlags.HasFlag(DMBDocumentationViewer.DocumentationMemberDisplayFlags.Summary);
}

@if (!string.IsNullOrWhiteSpace(Model.Title) || (showReferenceLink && !string.IsNullOrWhiteSpace(Model.ReferenceRoutePath)))
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <h5 class="mb-0">@Model.Title</h5>
        }
        @if (showReferenceLink && !string.IsNullOrWhiteSpace(Model.ReferenceRoutePath))
        {
            <a class="btn btn-sm btn-outline-primary" href="@Model.ReferenceRoutePath">
                <i class="bi bi-book" aria-hidden="true"></i>
                <span>@Model.ReferenceTitle</span>
            </a>
        }
    </div>
}

@if (Model.Members.Count == 0)
{
    <p class="text-muted small mb-0">No documented members found.</p>
}
else
{
    <ul class="list-group">
        @foreach (DMBDocumentationViewer.DocumentationMemberQueryResult member in Model.Members)
        {
            <li class="list-group-item">
                <div class="flex-grow-1">
                    @if (showSignature)
                    {
                        <code class="px-2 rounded">@member.Signature</code>
                    }
                    @if (showObsolete && member.IsObsolete)
                    {
                        <span class="badge text-bg-warning ms-2">obsolete</span>
                    }
                    @if (showExtensionType && !string.IsNullOrWhiteSpace(member.ExtensionTypeName))
                    {
                        <span class="badge text-bg-secondary ms-2">@member.ExtensionTypeName</span>
                    }
                    @if (showSummary && !string.IsNullOrWhiteSpace(member.SummaryHtml))
                    {
                        <div class="px-4 mt-2 mb-0">@Html.Raw(member.SummaryHtml)</div>
                    }
                </div>
            </li>
        }
    </ul>
}

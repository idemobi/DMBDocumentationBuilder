@{
    Layout = "_Layout";
}

@* ── Hero ── *@
@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Architecture — DocumentationViewer", TitleLevel.One).Render()
            @using (Html.PB_P().AsLead().Begin())
            {
                @:A runtime documentation viewer for generated API data.
            }
        }
    }
}

@using (Html.ContainerBuilder().SetPadding(SpacingSide.Y, SpacingSize.Five).Begin())
{
    @using (Html.RowBuilder().Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).Begin())
        {
            @* ── 1. Runtime Pages ── *@
            @Html.TitleBuilder().SetTitle("1. Runtime Pages", TitleLevel.Two).AsSectionHeading().Render()
            @using (Html.PB_P().Begin())
            {
                @using (Html.PB_Span().AsBold().Begin())
                {
                    @:DMBDocumentationViewer
                }
                @: is the runtime half of the documentation system. It reads generated documentation data, exposes MVC routes, renders documentation pages and provides MCP tools for agent-assisted documentation workflows.
                @: DocumentationViewer runs inside the ASP.NET Core website and depends on data generated by DocumentationBuilder.
            }
            @(Html.CodeBlock(@"// Routes exposed by DocumentationViewer
// /Documentation/Index          → documentation home
// /Documentation/ShowGroup      → group page
// /Documentation/ShowNamespace  → namespace page
// /Documentation/ShowObject     → type or member page", CodeLanguage.CSharp)
                .SetTitle("Documentation routes")
                .SetCopyButton())

            @* ── 2. Navigation Layer ── *@
            @Html.TitleBuilder().SetTitle("2. Navigation Layer", TitleLevel.Two).AsSubSectionHeading().Render()
            @using (Html.PB_P().Begin())
            {
                @:The registered sidebar provider maps documentation structure into navigation items. DocumentationViewer uses BootstrapBuilder shell composers to integrate the sidebar into the host website layout. The sidebar is generated by DocumentationBuilder and registered at application startup.
            }
            @(Html.CodeBlock(@"// Register the generated sidebar after documentation generation
using DocumentationBuilders.Documentation;

DocumentationSidebarProvider.Register();", CodeLanguage.CSharp)
                .SetTitle("Sidebar registration")
                .SetCopyButton())

            @* ── 3. MCP Endpoint ── *@
            @Html.TitleBuilder().SetTitle("3. MCP Endpoint", TitleLevel.Two).AsSubSectionHeading().Render()
            @using (Html.PB_P().Begin())
            {
                @:DocumentationViewer registers MCP tools for querying documentation and project context through the configured endpoint. This allows connected AI agents to look up API summaries, method signatures, namespace structures and cross-package relationships. The endpoint is mapped by
                @using (Html.PB_Span().AsMonospace().Begin())
                {
                    @:DMBDocumentationViewerConfiguration.UseApp(app)
                }
                @:.
            }
            @(Html.CodeBlock(@"// MCP tools are registered automatically
// Endpoint: configured via DMBDocumentationViewerConfiguration
DMBDocumentationViewerConfiguration.LoadCommonConfig(builder);
DMBDocumentationViewerConfiguration.UseApp(app);", CodeLanguage.CSharp)
                .SetTitle("MCP endpoint setup")
                .SetCopyButton())

            @* ── Tech Stack callout ── *@
            @using (Html.BlockBuilder().AsInfoCallout().Begin())
            {
                @using (Html.FlexBlockBuilder().Begin())
                {
                    @using (Html.BlockBuilder().AsCalloutIcon().Begin())
                    {
                        @using (Html.PB_Span().AddClass("bi bi-gear-fill fs-2 text-info").Begin()) { }
                    }
                    @using (Html.BlockBuilder().Begin())
                    {
                        @Html.TitleBuilder().SetTitle("Tech Stack", TitleLevel.Five).AsAlertHeading().Render()
                        @using (Html.BlockBuilder().AsSidebarRow().Begin())
                        {
                            @using (Html.PB_Span().AsBold().Begin())
                            {
                                @:Backend:
                            }
                            @: .NET 10 / ASP.NET Core
                        }
                        @using (Html.BlockBuilder().AsSidebarRow().Begin())
                        {
                            @using (Html.PB_Span().AsBold().Begin())
                            {
                                @:Protocol:
                            }
                            @: MCP (Model Context Protocol)
                        }
                        @using (Html.BlockBuilder().AsSidebarRow().Begin())
                        {
                            @using (Html.PB_Span().AsBold().Begin())
                            {
                                @:Architecture:
                            }
                            @: Runtime page rendering
                        }
                        @using (Html.BlockBuilder().AsSidebarRow().Begin())
                        {
                            @using (Html.PB_Span().AsBold().Begin())
                            {
                                @:Integration:
                            }
                            @: DocumentationBuilder output
                        }
                    }
                }
            }

            @* ── Next Step ── *@
            @using (Html.BlockBuilder().AsSidebarNote().Begin())
            {
                @using (Html.BlockBuilder().AsTextCenter().Begin())
                {
                    @Html.TitleBuilder().SetTitle("See it in action", TitleLevel.Four).Render()
                    @using (Html.PB_P().AsSmallMuted().Begin())
                    {
                        @:Learn how documentation requests flow from route to rendered page and MCP response.
                    }
                    @Html.Button(ActionItemFactory.AspRoute("DocumentationViewer", "RenderingPipeline").SetTitle("Rendering Pipeline").SetIcon(IconStruct.Bootstrap("bi-bezier2")).SetVariant(VariantStyle.Primary)).Render()
                }
            }
        }
    }
}
